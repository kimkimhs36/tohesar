<section class="live-desk" aria-labelledby="live-desk-title">
  <header class="live-desk-head">
    <span class="live-desk-overline"><span class="live-desk-dot" aria-hidden="true"></span> NEWS / SOURCE RADAR</span>
    <h2 id="live-desk-title">지금 자동차 세계</h2>
    <p id="live-desk-status" class="live-desk-status" aria-live="polite">새 소식을 확인하고 있습니다.</p>
  </header>
  <ol id="live-desk-feed" class="live-desk-feed">
    <li><a href="/radar/">포르쉐 · BMW · 자동차 전문 매체의 최신 소식 살펴보기 <span aria-hidden="true">↗</span></a></li>
  </ol>
  <a class="live-desk-all" href="/radar/">모든 소식 보기 <span aria-hidden="true">↗</span></a>
  <p class="live-desk-note">원문 출처 링크 · TOHEŞAR 자체 기사와 구분</p>
</section>
<script>
  const list=document.getElementById('live-desk-feed');
  const status=document.getElementById('live-desk-status');
  if(list&&status) fetch('/api/radar',{headers:{Accept:'application/json'}}).then(r=>r.json()).then(data=>{
    if(!Array.isArray(data.articles) || !data.articles.length)throw new Error('empty feed');
    const fragment=document.createDocumentFragment();
    for(const item of data.articles.slice(0,4)){
      if(typeof item.url!=='string'||!item.url.startsWith('https://'))continue;
      const li=document.createElement('li'), a=document.createElement('a');
      a.href=item.url;a.target='_blank';a.rel='noopener noreferrer external';
      const headline=document.createElement('strong');headline.textContent=item.title;headline.lang='en';
      const meta=document.createElement('small');meta.textContent=item.source+' · '+new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',month:'short',day:'numeric'}).format(new Date(item.published_at));
      a.append(headline,meta);li.append(a);fragment.append(li);
    }
    if(fragment.childNodes.length){list.replaceChildren(fragment);status.textContent='오늘의 외부 뉴스 헤드라인';}
  }).catch(()=>{status.textContent='뉴스 연결이 지연됩니다. Radar에서 다시 시도하세요.';});
</script>
<style is:global>
.live-desk{color:var(--ink)}
.live-desk-head{border-top:2px solid var(--ink);padding:16px 0 10px}
.live-desk-overline{display:inline-flex;align-items:center;gap:7px;font-size:9px;letter-spacing:.12em;color:#6d665c}
.live-desk-dot{width:6px;height:6px;border-radius:50%;background:#658a72}
.live-desk h2{font:600 21px/1.45 'TOHESAR Serif',serif;letter-spacing:-.045em;margin-top:10px}
.live-desk-status{font-size:10px;color:#77746c;margin:5px 0 2px;line-height:1.5}
.live-desk-feed{list-style:none;padding:0;margin:6px 0 0}
.live-desk-feed li{border-bottom:1px solid var(--rule)}
.live-desk-feed a{display:block;padding:15px 0 16px;min-height:60px;line-height:1.4}
.live-desk-feed strong{display:block;font:500 16px/1.5 'TOHESAR Serif',serif;word-break:normal;overflow-wrap:break-word}
.live-desk-feed small{display:block;color:var(--muted);font-size:10px;line-height:1.4;margin-top:7px}
.live-desk-all{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--ink);padding:14px 0 11px;font-size:11px;margin-top:8px;min-height:44px}
.live-desk-note{font-size:9px;color:var(--muted);line-height:1.5;margin-top:12px}
@media(max-width:767px){
 .live-desk{padding:0}
 .live-desk h2{font-size:23px;margin-top:8px}
 .live-desk-head{padding-top:14px}
 .live-desk-feed a{padding:15px 0}
 .live-desk-feed strong{font-size:17px}
 .live-desk-all{font-size:12px}
}
</style>