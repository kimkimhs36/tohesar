---
import Base from '../layouts/Base.astro';
import StoryRow from '../components/StoryRow.astro';
import { visibleArticles, isPreview } from '../lib/publication';
const stories = (await visibleArticles())
  .map((e) => e.data)
  .sort((a, b) => (b.published_at || b.modified_at).localeCompare(a.published_at || a.modified_at));
---

<Base title="Latest · 최근의 이야기">
  <div class="wrap listing-page">
    <header class="page-intro">
      <span class="eyebrow">THE READING DESK</span>
      <h1>
        <em>Latest</em>최근의 이야기
      </h1>
      <p>
        {isPreview
          ? '새 소식을 꾸며내지 않습니다. 먼저 세 편의 미발행 편집 샘플로 읽기 경험을 확인합니다.'
          : '새롭게 발행된 자동차와 기계 문화의 이야기.'}
      </p>
    </header>
    <div class="article-list">
      {stories.map((a, i) => (
        <StoryRow story={a} index={i} />
      ))}
    </div>
    {!stories.length && (
      <div class="empty-state">
        <h2>아직 발행된 기사가 없습니다.</h2>
        <p>검토를 마친 기사를 이곳에서 소개합니다.</p>
      </div>
    )}
  </div>
</Base>
