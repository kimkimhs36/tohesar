---
import '../styles/global.css';
import '../styles/first-impression.css';
import { Picture } from 'astro:assets';
import f40 from '../assets/photos/f40.jpg';
import porsche from '../assets/photos/porsche-911.jpg';
import registry from '../../content-assets.json';

const f40Rights = registry.find(item => item.id === 'f40')!;
const porscheRights = registry.find(item => item.id === 'porsche-911')!;
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#e9e9dd" />
  <meta name="description" content="TOHEŞAR FIRST IMPRESSION 001 — 자동차를 읽는 아름다운 첫 장면. 실제 자동차 사진, 실시간 소식, 디자인 저널을 연결하는 독립 시네마틱 실험." />
  <meta name="apple-mobile-web-app-title" content="TOHEŞAR" />
  <link rel="icon" href="/identity/favicon.svg" type="image/svg+xml" />
  <title>FIRST IMPRESSION 001 — TOHEŞAR</title>
</head>
<body class="fi-body">
  <a class="fi-skip" href="#fi-content">본문 바로가기</a>
  <div class="fi-page">
    <section class="fi-intro" aria-labelledby="fi-hero-heading">
      <div class="fi-light fi-light-a" aria-hidden="true"></div>
      <div class="fi-light fi-light-b" aria-hidden="true"></div>
      <div class="fi-haze" aria-hidden="true"></div>

      <header class="fi-header">
        <a href="/" class="fi-brand" aria-label="TOHEŞAR 기존 홈페이지">
          <img src="/identity/wordmark.svg" alt="TOHEŞAR" width="1109" height="255" />
        </a>
        <nav class="fi-topnav" aria-label="주요 메뉴">
          <a class="fi-topnav-link" href="/radar/">NEWS</a>
          <a class="fi-topnav-link" href="/features/">JOURNAL</a>
          <details class="fi-menu">
            <summary aria-label="메뉴 열기"><span></span><span></span></summary>
            <div class="fi-menu-panel">
              <a href="/radar/">지금 자동차 뉴스</a>
              <a href="/features/">디자인 저널</a>
              <a href="/archive/">아카이브</a>
              <a href="/subjects/">분야별 탐색</a>
              <a href="/search/">검색</a>
              <a href="/">V3.2 원본 비교</a>
            </div>
          </details>
        </nav>
      </header>

      <div class="fi-intro-content" id="fi-content">
        <div class="fi-intro-overline"><span class="fi-issue">THE MOTORING JOURNAL</span><span>SEOUL / EVERYWHERE</span></div>
        <h1 id="fi-hero-heading">시대는 흘러도,<br/><em>형태는 남는다.</em></h1>
        <div class="fi-intro-bottom">
          <p>자동차의 오늘을 읽고,<br />오래 남을 아름다움을 기록합니다.</p>
          <a href="#fi-news" class="fi-explore">EXPLORE THE JOURNAL <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <div class="fi-image-stage">
        <div class="fi-photo-ambient" aria-hidden="true"></div>
        <div class="fi-photo-shell">
          <Picture src={f40} formats={['webp']} widths={[480, 800, 1200, 1600]} sizes="(max-width: 699px) 100vw, 88vw" alt={f40Rights.alt} loading="eager" fetchpriority="high" decoding="async" class="fi-hero-image" />
          <div class="fi-film-vignette" aria-hidden="true"></div>
          <div class="fi-photo-topline"><span>001 / A STUDY IN FORM</span><span>FERRARI — 1987</span></div>
          <a href="/articles/f40/" class="fi-feature-link">
            <span class="fi-feature-label">THE DESIGN FILE</span>
            <span class="fi-feature-title">페라리 F40<br/><em>속도가 만든 조형.</em></span>
            <span class="fi-feature-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="fi-image-foot">
          <span>FERRARI F40 · LONDON CONCOURS, 2023</span>
          <span>PHOTO: <a href={f40Rights.source} target="_blank" rel="noopener noreferrer">{f40Rights.credit}</a> · <a href={f40Rights.licence_url} target="_blank" rel="noopener noreferrer">{f40Rights.licence}</a></span>
        </div>
      </div>
      <div class="fi-scroll-cue" aria-hidden="true"><span>SCROLL TO DISCOVER</span><span class="fi-scroll-line"></span><span>01 — 03</span></div>
    </section>

    <section class="fi-news" id="fi-news" aria-labelledby="fi-news-title">
      <div class="fi-news-heading">
        <div><span class="fi-section-no">01 / THE DISPATCH</span><h2 id="fi-news-title">자동차 세계의 <em>오늘.</em></h2></div>
        <a href="/radar/" class="fi-arrow-link">모든 소식 <span aria-hidden="true">↗</span></a>
      </div>
      <p class="fi-news-intro">실제 발행처가 전하는 소식. 출처를 따라가면 이야기가 이어집니다.</p>
      <ol id="fi-headlines" class="fi-headlines">
        <li><a href="/radar/" class="fi-headline"><span class="fi-headline-index">01</span><span class="fi-headline-main"><strong>최신 자동차 뉴스를 불러오는 중입니다.</strong><small>PORSCHE NEWSROOM · BMW PRESSCLUB · MOTOR1</small></span><span class="fi-headline-arrow" aria-hidden="true">↗</span></a></li>
      </ol>
      <div class="fi-news-foot"><span id="fi-feed-status" aria-live="polite">공개 뉴스 소스에 연결 중</span><span>원문 헤드라인 · 외부 발행처</span></div>
    </section>

    <section class="fi-feature" aria-labelledby="fi-feature-title">
      <div class="fi-feature-air fi-feature-air-a" aria-hidden="true"></div>
      <div class="fi-feature-air fi-feature-air-b" aria-hidden="true"></div>
      <div class="fi-feature-layout">
        <div class="fi-feature-head">
          <span class="fi-section-no">02 / LONG FORM</span>
          <h2 id="fi-feature-title">변화는<br/>계속된다.<br/><em>선은 남는다.</em></h2>
          <p>1963년부터 오늘까지. 포르쉐 911이 자신만의 실루엣을 지켜 온 이유.</p>
          <a href="/articles/porsche-911/" class="fi-feature-cta">911의 디자인 이야기 <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="fi-porsche-figure">
          <a href="/articles/porsche-911/" aria-label="포르쉐 911 디자인 이야기 읽기" class="fi-porsche-image-wrap">
            <Picture src={porsche} formats={['webp']} widths={[480,800,1200,1600]} sizes="(max-width: 699px) 100vw, 62vw" alt={porscheRights.alt} loading="lazy" decoding="async" class="fi-porsche-image" />
            <span class="fi-figure-photo-index">PORSCHE 911 CARRERA RSR / 1973</span>
          </a>
          <figcaption>{porscheRights.caption} · <a href={porscheRights.source} target="_blank" rel="noopener noreferrer">{porscheRights.credit}</a> / <a href={porscheRights.licence_url} target="_blank" rel="noopener noreferrer">{porscheRights.licence}</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="fi-end" aria-labelledby="fi-end-title">
      <div class="fi-end-top"><span class="fi-section-no">03 / THE JOURNAL</span><span>DESIGN · HISTORY · THE PRESENT</span></div>
      <h2 id="fi-end-title">기계를 넘어,<br/><em>그 시대를 보다.</em></h2>
      <p>한 대의 차에는 기술뿐 아니라 사람, 장소, 문화가 남습니다. TOHEŞAR는 그 이야기를 읽는 공간입니다.</p>
      <div class="fi-end-links"><a href="/radar/">최신 소식 <span aria-hidden="true">↗</span></a><a href="/features/">긴 이야기 <span aria-hidden="true">↗</span></a><a href="/archive/">아카이브 <span aria-hidden="true">↗</span></a></div>
      <div class="fi-end-brand"><img src="/identity/wordmark.svg" alt="TOHEŞAR" width="1109" height="255" /><img class="fi-end-symbol" src="/identity/cedilla.svg" alt="세디유" width="70" height="70" /></div>
      <div class="fi-last-line"><span>FIRST IMPRESSION 001 · PRIVATE DESIGN EXPERIMENT</span><a href="/">BACK TO V3.2 ↗</a></div>
    </section>
  </div>
  <script>
    type FeedItem = { title:string; url:string; source:string; source_id:string; category:string; published_at:string; };
    const feed = document.querySelector<HTMLOListElement>('#fi-headlines');
    const status = document.querySelector<HTMLElement>('#fi-feed-status');
    if (feed && status) {
      fetch('/api/radar', { headers:{ Accept:'application/json' } })
        .then(response => response.json())
        .then((json) => {
          const items:FeedItem[] = Array.isArray(json.articles) ? json.articles : [];
          if (!items.length) throw Error('empty-feed');
          const fragment = document.createDocumentFragment();
          for (const [i, item] of items.slice(0, 3).entries()) {
            if (!item.url.startsWith('https://')) continue;
            const li = document.createElement('li');
            const link = document.createElement('a');
            link.href = item.url;
            link.className = 'fi-headline';
            link.target = '_blank';
            link.rel = 'noopener noreferrer external';
            const no = document.createElement('span');
            no.className = 'fi-headline-index';
            no.textContent = String(i + 1).padStart(2,'0');
            const inner = document.createElement('span');
            inner.className = 'fi-headline-main';
            const title = document.createElement('strong');
            title.lang = 'en';
            title.textContent = item.title;
            const source = document.createElement('small');
            const date = new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',month:'short',day:'numeric'}).format(new Date(item.published_at));
            source.textContent = item.source.toUpperCase() + ' / ' + date + ' · ORIGINAL';
            const arrow = document.createElement('span');
            arrow.className = 'fi-headline-arrow';
            arrow.textContent = '↗';
            arrow.setAttribute('aria-hidden', 'true');
            inner.append(title, source);
            link.append(no, inner, arrow);
            li.append(link);
            fragment.append(li);
          }
          if (fragment.childNodes.length) feed.replaceChildren(fragment);
          status.textContent = '외부 뉴스 ' + items.length + '건 확인 · 원문은 발행처에서 읽기';
        })
        .catch(() => { status.textContent = '뉴스 연결이 지연됩니다 · RADAR에서 다시 확인'; });
    }
    const menu = document.querySelector<HTMLDetailsElement>('.fi-menu');
    document.addEventListener('keydown', (e) => { if (e.key==='Escape' && menu?.open) menu.open=false; });
    document.addEventListener('click', (e) => {
      if(menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open=false;
    });
  </script>
</body>
</html>
