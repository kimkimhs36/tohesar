---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import StoryRow from '../components/StoryRow.astro';
import RadarPreview from '../components/RadarPreview.astro';
import { visibleArticles, href, subjects } from '../lib/publication';
const stories = (await visibleArticles()).map((e) => e.data);
const lead = stories.find((a) => a.slug === 'f40') || stories[0];
const secondary = stories.find((a) => a.slug === 'porsche-911');
const archive = stories.find((a) => a.slug === 'ducati-916');
---

<Base title="자동차를 읽는 시간">
  <div class="wrap">
    {lead ? (
      <section class="front-page" aria-labelledby="lead-title">
        <div class="lead-story">
          <div class="section-label">
            <span>THE DESIGN FILE</span>
            <span>
              {lead.marque?.toUpperCase()} {lead.model} <span class="meta-divider">/</span>{' '}
              {lead.era}
            </span>
          </div>
          <header class="lead-heading">
            <h1 id="lead-title">
              <a href={href(lead)}>{lead.title}</a>
            </h1>
            <p class="lead-kicker">FORM FOLLOWS PURPOSE.</p>
          </header>
          <Photo id={lead.hero} href={href(lead)} priority transition />
          <div class="lead-deck">
            <p>
              낮은 차체, 깊게 파인 흡기구, 거대한 리어윙.
              <br class="desktop-break" /> 1987년의 F40에서 목적이 만든 아름다움을 읽는다.
            </p>
            <a class="text-link" href={href(lead)}>
              이야기 읽기 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <aside class="latest-column" aria-label="최근 편집">
          <div class="section-heading">
            <h2>
              최근의 이야기 <em>Latest</em>
            </h2>
            <a href="/latest/" aria-label="최근 이야기 모두 보기">
              ↗
            </a>
          </div>
          <p class="section-intro">지금 읽어 볼 세 편의 편집 샘플.</p>
          {stories.map((a, i) => (
            <StoryRow story={a} index={i} />
          ))}
          <div class="editor-note">
            <span class="eyebrow">FROM THE EDITORS</span>
            <p>
              새로운 것의 속도보다,
              <br />
              오래 남는 것의 이유를.
            </p>
            <a class="text-link" href="/about/">
              TOHEŞAR의 편집 원칙 ↗
            </a>
          </div>
        </aside>
      </section>
    ) : (
      <section class="page-intro">
        <span class="eyebrow">THE JOURNAL</span>
        <h1>첫 번째 발행을 준비합니다.</h1>
        <p>검토가 끝난 이야기부터 차례로 소개하겠습니다.</p>
      </section>
    )}
    <RadarPreview />
    <section class="editorial-dossier-spotlight" aria-labelledby="dossier-title">
      <div class="dossier-top"><span>THE DESIGN INTELLIGENCE / STUDY 001</span><span>PORSCHE · OCTOBER 2026</span></div>
      <div class="dossier-layout">
        <div><span class="dossier-kicker">THE NEW PORSCHE VISION</span><h2 id="dossier-title"><a href="/editorial/mission-s/">Mission S,<br /><em>형태가 미래를</em><br />예고할 때.</a></h2><p>새로운 포르쉐 비전 모델은 어떤 미래를 가리키는가. 2026년 공식 발표를 바탕으로 디자인 정체성과 미드 엔진 플랫폼의 의미를 읽는다.</p><a class="dossier-link" href="/editorial/mission-s/">한국어 디자인 분석 읽기 <span>↗</span></a></div>
        <a class="dossier-art" href="/editorial/mission-s/" aria-label="Mission S 분석 기사 열기"><small>FORM / FUTURE / IDENTITY</small><strong>MS.</strong><span>NO FABRICATED CAR IMAGE. / EDITORIAL STUDY.</span></a>
      </div>
      <p class="dossier-disclosure">공식 발표 근거의 편집 검토 초안 · 양산 확정 보도가 아님 · 그래픽은 TOHEŞAR의 활자 디자인</p>
    </section>
    <style is:global>
      .editorial-dossier-spotlight{margin:0 0 58px;background:#e6eae2;border-block:1px solid #a4b4a3;padding:24px clamp(18px,3vw,45px) 22px;color:#1b3228}
      .dossier-top{display:flex;justify-content:space-between;gap:20px;font-size:10px;letter-spacing:.08em;border-bottom:1px solid #9daf9d;padding-bottom:13px}
      .dossier-layout{display:grid;grid-template-columns:1fr .78fr;gap:38px;padding-top:31px}
      .dossier-kicker{font-size:10px;letter-spacing:.1em;color:#597c61}
      .dossier-layout h2{font:500 clamp(30px,4vw,53px)/1.3 'TOHESAR Serif',Georgia,serif;letter-spacing:-.04em;margin:15px 0 17px}
      .dossier-layout h2 em{font-family:'TOHESAR Serif',serif;font-style:normal;color:#5f8167;font-weight:450}
      .dossier-layout p{font-size:13px;line-height:1.9;max-width:440px;color:#425f4d;margin:0 0 18px}
      .dossier-link{display:inline-flex;align-items:center;gap:25px;font-size:11px;border-bottom:1px solid #33583d;padding-bottom:8px}
      .dossier-art{display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;min-height:310px;color:#f0f5e9;background:radial-gradient(ellipse at 70% 20%,#829989,#456b5f 43%,#193f35 85%);padding:23px;isolation:isolate}
      .dossier-art small,.dossier-art span{font:9px 'TOHESAR Sans',sans-serif;letter-spacing:.09em}
      .dossier-art strong{font:400 clamp(110px,16vw,230px)/.7 Georgia,serif;letter-spacing:-.13em}
      .dossier-disclosure{font-size:10px;color:#6a7a69;margin-top:20px}
      @media(max-width:760px){.editorial-dossier-spotlight{margin-bottom:40px}.dossier-top{font-size:8px}.dossier-layout{grid-template-columns:1fr;gap:26px}.dossier-layout h2{font-size:35px}.dossier-art{min-height:270px}.dossier-art strong{font-size:clamp(130px,38vw,230px)}.dossier-disclosure{line-height:1.8}}
    </style>
    {secondary && (
      <section class="feature-spread" aria-labelledby="feature-title">
        <div class="section-heading full">
          <h2>
            깊이 읽기 <em>Features</em>
          </h2>
          <a class="text-link" href="/features/">
            모든 피처 ↗
          </a>
        </div>
        <Photo
          id={secondary.hero}
          href={href(secondary)}
          sizes="(max-width:767px) calc(100vw - 40px), 60vw"
        />
        <div class="feature-copy">
          <span class="eyebrow">
            PORSCHE <span class="meta-divider">/</span> DESIGN & HISTORY
          </span>
          <h2 id="feature-title">
            <a href={href(secondary)}>
              변하는 자동차,
              <br />
              <em>남아 있는 실루엣.</em>
            </a>
          </h2>
          <p>{secondary.deck}</p>
          <a class="text-link" href={href(secondary)}>
            911의 이야기 읽기 ↗
          </a>
          <span class="reading-note">미발행 샘플 · {secondary.reading_minutes}분 읽기</span>
        </div>
      </section>
    )}
    {archive && (
      <section class="journal-spread" aria-labelledby="journal-title">
        <div class="journal-copy">
          <div class="section-heading">
            <h2 id="journal-title">
              시간의 기록 <em>Archive</em>
            </h2>
          </div>
          <span class="eyebrow">
            MOTORCYCLES <span class="meta-divider">/</span> 1994
          </span>
          <h3>
            <a href={href(archive)}>
              두카티 916,
              <br />
              기능이 만들어 낸 우아함
            </a>
          </h3>
          <p>{archive.deck}</p>
          <a href={href(archive)} class="text-link">
            아카이브에서 읽기 ↗
          </a>
        </div>
        <Photo
          id={archive.hero}
          href={href(archive)}
          sizes="(max-width:767px) calc(100vw - 40px), 45vw"
        />
      </section>
    )}
    <section class="subjects-strip" aria-labelledby="subjects-title">
      <div>
        <span class="eyebrow">THE SUBJECT INDEX</span>
        <h2 id="subjects-title">바퀴 너머의 세계</h2>
        <p>자동차에서 출발해, 기계가 만든 문화를 따라갑니다.</p>
      </div>
      <nav aria-label="분야별 읽기">
        {subjects.map(([key, name, ko], i) => (
          <a href={`/subjects/${key}/`}>
            <span class="index-no">0{i + 1}</span>
            <span>
              {name}
              <small>{ko}</small>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </section>
    <section class="film-note">
      <span class="eyebrow">PHOTO ESSAYS & FILM</span>
      <h2>사진과 영상으로 읽는 기계.</h2>
      <p>출처와 사용 권리를 확인한 작업을 준비하고 있습니다.</p>
      <a class="text-link" href="/subjects/film-machines/">
        영화와 기계 살펴보기 ↗
      </a>
    </section>
  </div>
</Base>
