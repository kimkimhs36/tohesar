{
  "name": "tohesar-v3",
  "version": "3.0.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "astro check",
    "fonts": "python scripts/subset-fonts.py",
    "format": "prettier --write src tests astro.config.mjs playwright.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "^5.18.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
